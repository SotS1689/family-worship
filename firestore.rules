// Firestore access rules for Family Worship (paste into Firebase console >
// Firestore Database > Rules, then Publish). Each signed-in family can read and
// write only its own plans and check marks; nobody else's, and nothing at all
// when signed out. What is stored: see src/sync.js.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['settings', 'order', 'tracks', 'years']);

      match /years/{year} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && year.matches('^[0-9]{4}$')
          && request.resource.data.keys().hasOnly(['days']);
      }
    }
  }
}
